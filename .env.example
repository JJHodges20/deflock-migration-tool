# Copy this file to .env before the first start. Values stay on this machine; .env is git-ignored.

# Required: local database credentials (internal to the Compose network, never published).
POSTGRES_USER=deflock
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=deflock
# Required: internal password of the self-hosted geocoder database.
NOMINATIM_PASSWORD=change-me-local-only

# Optional: where the app listens on this machine (always bound to 127.0.0.1).
DEFLOCK_PORT=3000
DEFLOCK_APP_ENV=development
DEFLOCK_LOG_LEVEL=INFO

# Optional: public data sources used by the setup jobs (pinned in M0; change only with a new decision record).
OSM_EXTRACT_URL=https://download.geofabrik.de/north-america/us/colorado-latest.osm.pbf
PROTOMAPS_BUILD_URL=https://build.protomaps.com/20261015.pmtiles
PROTOMAPS_ASSETS_COMMIT=028c18f713baecad011301ff7a69acc39bcc2ae7
BASEMAP_BBOX=-109.30,36.80,-101.80,41.20
BASEMAP_FILE=colorado.pmtiles

# Optional: resource knobs for the pilot machine (8 GB Docker allocation).
GRAPH_BUILD_CONCURRENCY=8
VALHALLA_THREADS=2
GEOCODER_THREADS=8
# Optional TIGER address data (about 10 GB more in the geocoder database; approved in principle, off by default).
GEOCODER_IMPORT_TIGER=false

# M10 (extract-based camera sync): defaults shown; override only when the mounts differ from compose.yaml
# DEFLOCK_CAMERA_EXTRACT_DIR=/var/lib/deflock/extracts
# DEFLOCK_GRAPH_EXTRACT_PATH=/pbf/colorado-latest.osm.pbf
